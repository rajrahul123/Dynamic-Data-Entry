# Backend environment configuration (local development)
#
# Copy this file to `.env` and adjust values. Never commit the real `.env`.
#
# For production deployments you must set ENVIRONMENT=production and DEBUG=false.
# A production build refuses to start if CORS_ORIGINS contains a wildcard "*",
# so list every frontend origin explicitly.

# Application
ENVIRONMENT=development
DEBUG=true

# Full SQLAlchemy connection string (psycopg 3 driver).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://ddep_user:CHANGE_ME@localhost:5432/dynamic_data_entry

# Allowed CORS origins for the frontend clients. Accepts a JSON array
# (as shown below) or a comma-separated string, e.g.
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
# A single "*" is allowed for local development only; it is rejected when
# ENVIRONMENT=production.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# JWT authentication. Generate a strong random secret for local `.env`, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Per-IP rate limits for the public auth endpoints (slowapi syntax).
AUTH_LOGIN_RATE_LIMIT=5/minute
AUTH_REGISTER_RATE_LIMIT=3/minute
AUTH_FORGOT_PASSWORD_RATE_LIMIT=3/minute
AUTH_RESET_PASSWORD_RATE_LIMIT=5/minute

# Password reset. A 6-digit OTP is emailed to the user and must be redeemed
# within PASSWORD_RESET_OTP_EXPIRE_MINUTES.
PASSWORD_RESET_OTP_EXPIRE_MINUTES=10

# Billing: activation of subscriptions is stubbed. Development activates the
# picked plan on checkout immediately; production should disable this so
# checkout only returns a placeholder payment URL.
BILLING_AUTO_ACTIVATE=true

# SMTP / outbound email. Leave SMTP_HOST empty in local development: the app
# then logs the reset OTP instead of emailing it (visible in the backend
# console/logger only). Production MUST set a real SMTP relay so users get
# their reset codes. EMAILS_FROM_EMAIL defaults to megteach34@gmail.com so that
# a configured relay sends from that address by default.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=CHANGE_ME
# EMAILS_FROM_EMAIL=megteach34@gmail.com