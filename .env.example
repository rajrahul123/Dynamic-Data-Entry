# Copy this file's recommended values into the project `.env` files described
# below. Never commit `.env` files or real secrets.

# ---------------------------------------------------------------------------
# Backend: create `backend/.env` from `backend/.env.example`
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
# SQLAlchemy 2.x connection string using the psycopg 3 driver:
#   postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://ddep_user:CHANGE_ME@localhost:5432/dynamic_data_entry
# Allowed CORS origins for the frontend dev server (JSON array).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# JWT authentication. Generate a strong random secret for local `.env`, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Frontend: create `frontend/.env.development` from `frontend/.env.example`
# ---------------------------------------------------------------------------
# Optional. Only needed if the FastAPI backend does NOT run on
# http://localhost:8000. The Vite dev server proxies /api to this target.
VITE_API_PROXY_TARGET=http://localhost:8000